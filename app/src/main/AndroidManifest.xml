<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Para poder usar el reconocimiento de voz del celular (dictado) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="TecladoiOS"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="TecladoiOS" />

        <!-- Ícono de la app en el menú: se puede ocultar desde los ajustes -->
        <activity-alias
            android:name=".Lanzador"
            android:targetActivity=".SettingsActivity"
            android:exported="true"
            android:enabled="true"
            android:label="TecladoiOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".TecladoService"
            android:label="TecladoiOS"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
