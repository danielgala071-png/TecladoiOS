<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Solo si lo activas en Ajustes: los nombres de tus contactos (nunca salen del celular) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="TecladoiOS"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="TecladoiOS" />

        <!-- Ícono de la app en el menú: se puede ocultar desde los ajustes -->
        <activity-alias
            android:name=".Lanzador"
            android:targetActivity=".SettingsActivity"
            android:exported="true"
            android:enabled="true"
            android:label="TecladoiOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".TecladoService"
            android:label="TecladoiOS"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
